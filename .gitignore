# Nextflow
.nextflow/
.nextflow.log*
work/
results/
test_results/

# Per-cohort pipeline outputs (results_full_v2, results_lesions_csc, ...).
# Never tracked: they run to hundreds of MB and are regenerated by the
# pipeline. The small derived tables the manuscript reads are committed
# next to the scripts that make them instead.
results_*/

# Python bytecode
__pycache__/

# Run logs
*.log

# Singularity cache
singularity_cache/

# Conda env cache
conda_cache/

# Large reference files (build locally)
assets/hpv_references/*.fasta
assets/hpv_references/*.fai
assets/hpv_references/*.gff
assets/hpv_references/star_index/
assets/hpv_references/hisat2_index/
assets/kraken2_db/*.k2d
assets/kraken2_db/*.kmer_distrib

# OS
.DS_Store
Thumbs.db

# R / RStudio session artifacts. Per-user state, not project content: .Rhistory
# and .RData are whatever happened to be in one console, and the .Rproj file
# records one person's editor settings.
.Rhistory
.RData
.Rproj.user/
*.Rproj

# Claude Code
CLAUDE.md
.claude/

# Rendered reports (re-generated from .md)
reports/*.html

# Curation workbooks (generated; commit explicitly with `git add -f` if a
# specific snapshot needs versioning).
reports/*.xlsx

# Analysis caches: fetched SRA/BioSample metadata and other re-downloadable
# intermediates, in any analysis directory. Matches a directory named `cache`
# at any depth. (conda_cache/ and singularity_cache/ are listed separately
# above; they are tool caches rather than analysis ones.)
cache/

# Word lock files (created when a .docx is open)
~$*
